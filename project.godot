[application]
config/name="Комната 1604"
run/main_scene="res://menu.tscn"

[autoload]
; Единственный узел, переживающий перезагрузку сцены: он помнит, какой круг
; собирать. Круги переключаются именно перезагрузкой — см. комментарий в Game.gd.
Game="*res://scripts/systems/Game.gd"
; Слой площадки: SDK Яндекс Игр в вебе, полная заглушка везде ещё. Идёт после
; Game: подключает к нему облачное сохранение поверх локального.
Platform="*res://scripts/systems/Platform.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.012,0.015,0.025,1)

[input]
move_forward={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":68)]}
sprint={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
interact={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":69)]}
examine={"deadzone":0.3,"events":[Object(InputEventMouseButton,"button_index":1)]}
inspect_close={"deadzone":0.3,"events":[Object(InputEventMouseButton,"button_index":2)]}
