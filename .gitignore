# Кэш импорта Godot: пересобирается командой
#   godot_console.exe --headless --path . --import
.godot/

# Сборки. Настольный EXE весит 109 МБ — это выше жёсткого предела GitHub
# в 100 МБ на файл, и в репозиторий он не поедет в принципе.
# Веб-сборка лежит отдельно в docs/ — оттуда её отдаёт GitHub Pages.
build/

# Кадры проверок: регенерируются прогонами SHELL_SHOT и *_WALKTHROUGH,
# а весят 33 МБ.
qa_screens/

# Исходные материалы задания: референсы, карта, оригинал музыкальной дорожки.
# Двадцать мегабайт, которые игре не нужны — в сборку они и так не попадают
# (.gdignore внутри плюс exclude_filter в export_presets.cfg).
Задания/

# Локальные настройки редактора и инструментов.
*.tmp
.claude/
__pycache__/

# Логи прогонов: пересоздаются проверками.
*.log
